# Secrets et configuration locale — JAMAIS commités
.env
.env.*
!.env.example
!.env.production.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# Surcouche Docker locale : ports d'hôte et réglages propres à un poste. Compose la charge
# automatiquement par-dessus docker-compose.yml, qui reste la référence partagée. Utile quand la
# machine héberge déjà d'autres services et que 5432/6379/3000 ne sont pas libres.
docker-compose.override.yml

# Dépendances
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build
dist/
build/
out/
.vite/
*.tsbuildinfo

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# e2e (e2e/playwright.config.ts) — état d'authentification rejouable (cookie de session RÉEL,
# jamais commité) et captures produites par une exécution locale du harnais (livrées à @laupernoe hors
# dépôt, voir e2e/README.md « Captures »).
/e2e/.auth/
/e2e/captures-apres-refonte/

# Caches outils
.eslintcache
.turbo/
.cache/

# Logs
*.log
# Journaux de `screen` : capturent tout ce qui passe dans le terminal, y compris des
# jetons collés à la main. Ne doivent jamais partir sur le dépôt distant.
screenlog.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Données locales (dumps Postgres, volumes Docker, uploads de dev)
*.dump
*.sql.gz
.docker-data/
uploads/
tmp/

# Éditeurs et OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store


# CodeGraph — index de graphe du dépôt, reconstruit par `codegraph init` sur chaque poste
