# Secrets et configuration locale — JAMAIS commités
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# Surcouche Docker locale : ports d'hôte et réglages propres à un poste. Compose la charge
# automatiquement par-dessus docker-compose.yml, qui reste la référence partagée. Utile quand la
# machine héberge déjà d'autres services et que 5432/6379/3000 ne sont pas libres.
docker-compose.override.yml

# Dépendances
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build
dist/
build/
out/
.vite/
*.tsbuildinfo

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Caches outils
.eslintcache
.turbo/
.cache/

# Logs
*.log
# Journaux de `screen` : capturent tout ce qui passe dans le terminal, y compris des
# jetons collés à la main. Ne doivent jamais partir sur le dépôt distant.
screenlog.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Données locales (dumps Postgres, volumes Docker, uploads de dev)
*.dump
*.sql.gz
.docker-data/
uploads/
tmp/

# Éditeurs et OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store


# CodeGraph — index de graphe du dépôt, reconstruit par `codegraph init` sur chaque poste

# site/ (Astro, depuis le 17.08.2026 — remplace un socle Hugo+Blowfish
# construit puis écarté le même jour, voir site/README.md) : cache de
# contenu/types généré par `astro dev`/`astro build`. site/dist/ (sortie de
# build) et site/node_modules/ sont déjà couverts par les motifs génériques
# dist/ et node_modules/ ci-dessus — rien de spécifique à ajouter pour eux.
site/.astro/
# Dérivés redimensionnés des captures produit (générés au build par
# scripts/redimensionner-captures.mjs à partir de outils/captures/sortie,
# jamais la source elle-même) — reconstructibles, jamais commités, comme
# tout le reste de ce qui est généré au build.
site/public/captures-redim/
# ancien-site/ ne contient plus de projet Hugo (voir ancien-site/README.md) :
# seul l'ancien contenu HTML pré-Hugo y reste, versionné tel quel.
