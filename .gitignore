# Secrets and local configuration: never committed
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# Local Docker overrides (host ports, per-machine settings). Compose loads this file on top of
# docker-compose.yml automatically.
docker-compose.override.yml

# Dependencies
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build
dist/
build/
out/
.vite/
*.tsbuildinfo

# Tests and coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# e2e (e2e/playwright.config.ts): replayable authentication state (a real session cookie) and
# screenshots from a local run.
/e2e/.auth/
/e2e/captures-apres-refonte/

# Tool caches
.eslintcache
.turbo/
.cache/

# Logs
*.log
# `screen` logs capture everything typed in the terminal, tokens included.
screenlog.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Local data (Postgres dumps, Docker volumes, development uploads)
*.dump
*.sql.gz
.docker-data/
uploads/
tmp/

# Editors and OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Local working folders, not published
