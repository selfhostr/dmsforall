# Secrets et configuration locale — JAMAIS commités
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials.json

# Surcouche Docker locale : ports d'hôte et réglages propres à un poste. Compose la charge
# automatiquement par-dessus docker-compose.yml, qui reste la référence partagée. Utile quand la
# machine héberge déjà d'autres services et que 5432/6379/3000 ne sont pas libres.
docker-compose.override.yml

# Dépendances
node_modules/
.pnpm-store/
.yarn/
jspm_packages/

# Build
dist/
build/
out/
.vite/
*.tsbuildinfo

# Tests et couverture
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Caches outils
.eslintcache
.turbo/
.cache/
# Graphe de connaissances AST généré localement, volatil et volumineux
graphify-out/

# Logs
*.log
# Journaux de `screen` : capturent tout ce qui passe dans le terminal, y compris des
# jetons collés à la main. Ne doivent jamais partir sur le dépôt distant.
screenlog.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/

# Données locales (dumps Postgres, volumes Docker, uploads de dev)
*.dump
*.sql.gz
.docker-data/
uploads/
tmp/

# Éditeurs et OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Skills tierces installées localement par `npx skills add`, modifient le comportement des agents
.assistant/skills/*
!.assistant/skills/frontend-design/
# Fichier généré par `npx skills add`, lockfile d'installation locale
