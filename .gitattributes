# Normalisation des fins de ligne : LF en base, quel que soit l'OS de travail.
# Évite les diffs entiers de fichiers entre le poste Windows et les conteneurs Linux.
* text=auto eol=lf

# Scripts Windows : CRLF obligatoire pour rester exécutables
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binaires : jamais de conversion
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
