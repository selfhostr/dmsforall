# dmsforall settings. Optional: the stack starts without this file, on http://localhost:8080.
# To use it:  cp .env.example .env   then remove the # in front of the lines you need.
# Every other setting has a safe default. Advanced ones are in docs/reference/configuration.md.

# Version to run: a release number such as 0.3.0 (recommended, upgrade on purpose) or latest.
# DFA_VERSION=latest

# --- Server with a domain name: HTTPS certificate is obtained and renewed automatically ---
# Ports 80 and 443 must be reachable from the internet.
# DFA_SITE_ADDRESS=garage.example.org
# DFA_PUBLIC_URL=https://garage.example.org
# DFA_HTTP_PORT=80
# DFA_HTTPS_PORT=443

# --- Outgoing email (invoices, reminders). Without a host, nothing is sent. ---
# DFA_SMTP_HOST=smtp.example.org
# DFA_SMTP_PORT=587
# DFA_SMTP_USER=
# DFA_SMTP_PASSWORD=
# DFA_SMTP_FROM=no-reply@example.org

# --- Backups (docker compose --profile backup up -d): public key made with age-keygen ---
# AGE_CLE_PUBLIQUE=
