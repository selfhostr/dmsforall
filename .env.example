# dmsforall settings. Copy to .env and adjust:  cp .env.example .env
# .env is ignored by git. Never commit real values.
#
# The file has two parts:
#   1. Docker install (docker-compose.yml). Every variable starts with DFA_ and has a default,
#      so this file can be used as is for a first try on localhost.
#   2. Local development (pnpm dev, Node on the host). Used by apps/api and apps/web.
#
# The API validates its settings with a schema at startup and refuses to start when one is
# missing or invalid.

# =================================================================================================
# 1. Docker install
# =================================================================================================

# Image tag to run. A release number (0.3.0), a minor line (0.3), latest (last stable release)
# or edge (last build of the dev branch). Pin a number in production, to upgrade on purpose.
DFA_VERSION=latest

# Address Caddy answers on, and the public URL users type in the browser.
# First try on this machine, plain HTTP:
DFA_SITE_ADDRESS=http://localhost
DFA_PUBLIC_URL=http://localhost:8080
# For a real server, set a domain name instead. Caddy then gets and renews a Let's Encrypt
# certificate by itself (ports 80 and 443 must be reachable from the internet):
#   DFA_SITE_ADDRESS=garage.example.org
#   DFA_PUBLIC_URL=https://garage.example.org
#   DFA_HTTP_PORT=80
#   DFA_HTTPS_PORT=443
# The session cookie is marked Secure: over plain HTTP it works on localhost only, so use a
# domain name with HTTPS for anything else.

# Host ports published by the reverse proxy. The database and Valkey are never published.
DFA_HTTP_PORT=8080
DFA_HTTPS_PORT=8443

# Number of reverse proxies between the browser and the API, used to read the client address
# (rate limiting, security log). 1 is right for the bundled Caddy. Add one for each proxy or
# load balancer you put in front of it. Never use 0 behind a proxy.
DFA_TRUST_PROXY_HOPS=1

# Log level: debug, info, warn or error.
DFA_LOG_LEVEL=info

# Serve the interactive API documentation at /api/docs and /api/docs.json without
# authentication. Leave false unless you need it.
DFA_EXPOSE_API_DOCS=false

# Error reporting to a Sentry compatible server. Empty disables it.
DFA_SENTRY_DSN=

# Outgoing email (invoices, reminders). Empty host keeps email capture only: nothing is sent.
# One sender address for all garages, see apps/api/src/courriel/.
DFA_SMTP_HOST=
DFA_SMTP_PORT=587
# true for implicit TLS (port 465), false for STARTTLS (port 587).
DFA_SMTP_SECURE=false
DFA_SMTP_USER=
# Set it here only, never commit it. Compose reads the value as is.
DFA_SMTP_PASSWORD=
DFA_SMTP_FROM=
# Must be true to really send. Test data contains fake customer addresses: keep false on a demo.
DFA_SMTP_ENABLED=false
# Key that encrypts each garage's own SMTP password (set in the app). 32 bytes, base64:
# `openssl rand -base64 32`. Keep it safe; changing it means typing the passwords again.
DFA_SECRETS_KEY=
# Allow a garage's sending server on a private network in production (default false).
DFA_SMTP_ALLOW_PRIVATE_NETWORK=false

# Backup profile (docker compose --profile backup up -d): public key of an age key pair made
# with age-keygen on another machine. The private key never needs to be on this server.
# AGE_CLE_PUBLIQUE=

# Where things are stored (Docker named volumes, see `docker volume ls`):
#   dmsforall_dfa_postgres_data   database
#   dmsforall_dfa_api_uploads     generated invoice PDFs
#   dmsforall_dfa_exports_resiliation   exit exports handed to a garage
#   dmsforall_dfa_secrets         generated database passwords
#   dmsforall_dfa_postgres_backups   encrypted backups of the database and the files (backup profile)

# =================================================================================================
# 2. Local development (pnpm dev). Not read by docker-compose.yml.
# =================================================================================================

# development | test | production. Controls logs, detailed errors and some safeguards.
NODE_ENV=development

# HTTP port of the API.
PORT=3000

# Public URL of the API and of the web app. Used for CORS and for links in emails.
API_URL_PUBLIQUE=http://localhost:3000
WEB_URL_PUBLIQUE=http://localhost:5173

# --- Database: two distinct roles, never the superuser ---

# Role used by the running API (dfa_app). Not a superuser, does not own the tables, so it is
# subject to the row level security policies that isolate garages from each other. Created by
# docker/postgres/init/01-roles.sql.
DATABASE_URL=postgresql://dfa_app:dfa_app_dev@localhost:5432/dfa_dev

# Role used by migrations only (dfa_migrator, owner of the schema). Must differ from
# DATABASE_URL: the API refuses to start otherwise.
DATABASE_URL_MIGRATION=postgresql://dfa_migrator:dfa_migrator_dev@localhost:5432/dfa_dev

# Connection pool: maximum size, connections kept warm, query timeout, connection wait timeout
# and idle timeout (milliseconds).
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2
DATABASE_TIMEOUT_REQUETE_MS=10000
DATABASE_TIMEOUT_CONNEXION_MS=5000
DATABASE_TIMEOUT_IDLE_MS=30000

# Valkey (Redis-compatible): cache and job queues. The URL scheme stays redis://.
REDIS_URL=redis://localhost:6379

# --- Sessions ---
# Session tokens are random, stored as SHA-256 hashes: there is no session secret to set.
SESSION_COOKIE_NOM=dfa_session
# Maximum session length, then idle timeout, in minutes.
SESSION_DUREE_MINUTES=480
SESSION_INACTIVITE_MINUTES=120
# Secure attribute of the session cookie. false on plain HTTP in development, must be true in
# production.
COOKIE_SECURE=false
# Cookie Domain attribute. Leave empty unless the API and the web app are on different
# subdomains of one domain.
COOKIE_DOMAINE=

# --- Password hashing (Argon2id, OWASP recommendations) ---
ARGON2_MEMOIRE_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISME=1

# Exact number of reverse proxies between the client and the API (Express trust proxy). Decides
# which X-Forwarded-For address counts as the client address. 0 means no proxy, right when the
# API is reached directly. Never true: that would trust a header the client controls.
TRUST_PROXY_HOPS=0

# --- Login brute-force protection ---
# Per IP and per email budget in a sliding window, plus progressive account lock after
# consecutive failures. LIMITE_CONNEXION_COMPTE must stay above SEUIL_VERROUILLAGE_COMPTE.
LIMITE_CONNEXION_IP=20
LIMITE_CONNEXION_COMPTE=15
LIMITE_FENETRE_SECONDES=900
SEUIL_VERROUILLAGE_COMPTE=5

# --- Search rate limit, per user ---
LIMITE_RECHERCHE_UTILISATEUR=40
LIMITE_RECHERCHE_FENETRE_SECONDES=30

# --- Observability and miscellany ---

# Structured JSON log level: debug | info | warn | error.
LOG_NIVEAU=debug

# Interactive API documentation (/docs and /docs.json). These routes sit outside the
# authentication guard, so the default is false; true in development.
OPENAPI_EXPOSER_DOCS=true

# Version and branch reported by the health endpoint. Leave empty in development: they are
# computed from the local git repository at each start. The Docker image sets them at build time.
VERSION_APP=
VERSION_APP_BRANCHE=

# Check GitHub (server side, cached 12 h) for a newer release and show it to admins. false = no outgoing call.
VERIFIER_MISE_A_JOUR=true

# Sentry DSN of the API and environment name. Empty disables error reporting.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TAUX_ECHANTILLONNAGE_TRACES=0.05

# --- Operations console (optional, off by default) ---
# Connection of a dedicated dfa_console role. Empty: the console is not mounted at all.
# See apps/api/src/exploitation/config-console.ts and migration 0048 for the role definition.
DATABASE_URL_CONSOLE=
# CONSOLE_COOKIE_NOM=dfa_console_session
# CONSOLE_SESSION_DUREE_MINUTES=60
# CONSOLE_SESSION_INACTIVITE_MINUTES=15
# CONSOLE_POOL_MAX=2

# --- Outgoing email (SMTP) ---
# One sender for all garages. In development and test, emails are captured in the log and never
# sent. Real sending needs COURRIEL_ENVOI_REEL=true AND NODE_ENV=production.
SMTP_HOTE=
SMTP_PORT=587
SMTP_SECURISE=false
SMTP_UTILISATEUR=
# Leave empty here. Never run `source .env` with a password containing $: the shell would cut it.
SMTP_MOT_DE_PASSE=
SMTP_EXPEDITEUR=
COURRIEL_ENVOI_REEL=false
# Each garage can set its own sending server in the app (Settings > Sending e-mails); the SMTP_*
# variables above are only the fallback for garages that did not. The garage's SMTP password is
# encrypted with this key (32 bytes, base64): generate it with `openssl rand -base64 32`, keep it
# safe, and do not change it afterwards (saved passwords would have to be typed again).
CLE_CHIFFREMENT_SECRETS=
# Allow a garage's sending server on a private network (192.168.x, 10.x...) in production.
# Off by default so that the test button cannot be used to probe the server's internal network.
COURRIEL_RESEAU_PRIVE_AUTORISE=false

# --- Scheduled jobs (BullMQ, cron in UTC) ---
# Empty: active in production only. true or false forces the job on or off in any environment.
# Daily check of the Swiss vehicle reference data (ASTRA open data), default 17 4 * * *.
# REFERENTIEL_VEHICULES_CH_JOB_ACTIF=
# REFERENTIEL_VEHICULES_CH_JOB_CRON=17 4 * * *
# Daily automatic close of the time clock at end of day, default 30 0 * * *.
# POINTAGE_CLOTURE_AUTOMATIQUE_JOB_ACTIF=
# POINTAGE_CLOTURE_AUTOMATIQUE_JOB_CRON=30 0 * * *
# Hourly unpaid invoice reminders, default 12 * * * *. Runs in the worker process.
# RELANCES_FACTURE_JOB_ACTIF=
# RELANCES_FACTURE_JOB_CRON=12 * * * *
# Daily purge of a garage's data after its exit. DELETES DATA: never enable it on a machine
# where you do not know exactly what you test. Default 17 3 * * *.
# RESILIATION_PURGE_AUTOMATIQUE_JOB_ACTIF=
# RESILIATION_PURGE_AUTOMATIQUE_JOB_CRON=17 3 * * *

# --- Registration document scanner (OCR) ---
# URL of the scanner container. In development the API runs on the host, the scanner publishes
# port 8092 (docker-compose.dev.yml).
OCR_SERVICE_URL=http://localhost:8092
# OCR_SERVICE_TIMEOUT_MS=20000
# LIMITE_OCR_PERMIS_UTILISATEUR=15
# LIMITE_OCR_PERMIS_FENETRE_SECONDES=300

# --- Web app (apps/web) ---
# This file is the only source of VITE_* variables: Vite reads the repository root, not
# apps/web. Only VITE_* variables reach the browser code.
# API base path. A relative path works in development (Vite proxy) and in production.
VITE_API_URL=/api/v1
# Sentry DSN of the web app. Empty disables error reporting.
# VITE_SENTRY_DSN=
