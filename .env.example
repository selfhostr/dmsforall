# dmsforall settings. All optional: the stack starts without this file, on https://<address>:8443.
# To use it:  cp .env.example .env   then remove the # in front of the lines you need.
# Every other setting has a safe default. Advanced ones are in docs/reference/configuration.md.

# Version to run: a release number such as 0.4.0 (recommended, upgrade on purpose) or latest.
# DFA_VERSION=latest

# Published HTTPS port.
# DFA_PORT=8443

# Public address, when you put your own reverse proxy (with a real certificate) in front.
# Used for the links in emails and to check where requests come from.
# DFA_PUBLIC_URL=https://dmsforall.example.ch

# Outgoing email (invoices, reminders). Without a host, nothing is sent.
# DFA_SMTP_HOST=smtp.example.org
# DFA_SMTP_PORT=587
# DFA_SMTP_USER=
# DFA_SMTP_PASSWORD=
# DFA_SMTP_FROM=no-reply@example.org

# Daily backup (into ./backups): hour (server time, Europe/Zurich) and days kept.
# DFA_BACKUP_TIME=02:30
# DFA_BACKUP_KEEP_DAYS=14
