{
  "name": "@dfa/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Contrats partagés API <-> web : enums, problem+json, pagination, schémas zod",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "dev": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo"
  },
  "dependencies": {
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  }
}
