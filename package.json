{
  "name": "dmsforall",
  "version": "0.1.0",
  "private": true,
  "description": "DMS pour garages et concessions suisses",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @dfa/api dev",
    "dev:web": "pnpm --filter @dfa/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @dfa/api test:integration",
    "db:generate": "pnpm --filter @dfa/api db:generate",
    "db:migrate": "pnpm --filter @dfa/api db:migrate",
    "db:seed": "pnpm --filter @dfa/api db:seed",
    "api:openapi": "pnpm --filter @dfa/api openapi:export",
    "web:types": "pnpm --filter @dfa/web types:api",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}
