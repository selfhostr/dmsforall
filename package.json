{
  "name": "dmsforall",
  "version": "0.2.0",
  "private": true,
  "description": "Management software for Swiss garages and dealerships",
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:api": "pnpm --filter @dfa/api dev",
    "dev:web": "pnpm --filter @dfa/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @dfa/api test:integration",
    "db:generate": "pnpm --filter @dfa/api db:generate",
    "db:migrate": "pnpm --filter @dfa/api db:migrate",
    "db:seed": "pnpm --filter @dfa/api db:seed",
    "db:import:vehicules-ch": "pnpm --filter @dfa/api db:import:vehicules-ch",
    "api:openapi": "pnpm --filter @dfa/api openapi:export",
    "web:types": "pnpm --filter @dfa/web types:api",
    "docker:up": "DOCKER_HOST=\"${DOCKER_HOST:-unix:///var/run/docker.sock}\" docker compose -f docker-compose.dev.yml up -d",
    "docker:down": "DOCKER_HOST=\"${DOCKER_HOST:-unix:///var/run/docker.sock}\" docker compose -f docker-compose.dev.yml down",
    "docker:reset": "DOCKER_HOST=\"${DOCKER_HOST:-unix:///var/run/docker.sock}\" docker compose -f docker-compose.dev.yml down -v && DOCKER_HOST=\"${DOCKER_HOST:-unix:///var/run/docker.sock}\" docker compose -f docker-compose.dev.yml up -d",
    "e2e": "e2e/scripts/executer.sh build",
    "e2e:dev": "e2e/scripts/executer.sh dev",
    "e2e:report": "playwright show-report e2e/playwright-report"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
