{
  "name": "@dfa/api",
  "version": "0.1.0",
  "private": true,
  "description": "API DFA — NestJS, PostgreSQL/Drizzle, Redis",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unitaire",
    "test:watch": "vitest --project unitaire",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrer.ts",
    "db:seed": "tsx src/db/seed/seed-dev.ts",
    "db:import:vehicules-ch": "tsx src/db/seed/import-referentiel-vehicules-ch.ts",
    "openapi:export": "nest build && node dist/openapi/exporter-openapi.js"
  },
  "dependencies": {
    "@dfa/shared": "workspace:*",
    "@nestjs/common": "^11.0.10",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@nestjs/swagger": "^11.0.3",
    "@node-rs/argon2": "^2.0.2",
    "@sentry/nestjs": "^10.68.0",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.1",
    "jsqr": "^1.4.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "0.19.1",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swissqrbill": "4.4.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.2",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.10",
    "@swc/core": "^1.15.46",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.0.0",
    "testcontainers": "^12.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.9",
    "vitest": "^3.0.5"
  }
}
