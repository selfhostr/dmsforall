{
  "name": "@dfa/api",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "API DFA — NestJS, PostgreSQL/Drizzle, Redis",
  "scripts": {
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile main-worker",
    "build": "nest build",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/main-worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unitaire",
    "test:watch": "vitest --project unitaire",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrer.ts",
    "db:seed": "tsx src/db/seed/seed-dev.ts",
    "db:import:vehicules-ch": "tsx src/db/seed/import-referentiel-vehicules-ch.ts",
    "openapi:export": "nest build && node dist/openapi/exporter-openapi.js"
  },
  "dependencies": {
    "@dfa/shared": "workspace:*",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/nestjs": "^10.78.0",
    "bullmq": "^6.7.2",
    "cookie-parser": "^1.4.7",
    "csv-parse": "^7.0.3",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "ioredis": "^5.4.1",
    "jsqr": "^1.4.0",
    "nodemailer": "^10.4.0",
    "pdfjs-dist": "^4.10.38",
    "pdfkit": "0.20.2",
    "pg": "^8.23.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swissqrbill": "4.4.4",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.2.8",
    "@swc/core": "^1.16.22",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "qrcode": "^1.5.4",
    "supertest": "^7.3.2",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^4.1.12",
    "yazl": "^3.3.1"
  }
}
