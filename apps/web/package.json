{
  "name": "@dfa/web",
  "version": "0.1.0",
  "private": true,
  "description": "SPA React de dmsforall — client de l'API OpenAPI, sans accès privilégié",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "node scripts/verifier-i18n.mjs",
    "types:api": "openapi-typescript ../../packages/shared/openapi/dfa-openapi.json -o src/api/types.gen.ts",
    "api:types": "pnpm run types:api"
  },
  "dependencies": {
    "@dfa/shared": "workspace:*",
    "@hookform/resolvers": "^5.7.1",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/react": "^10.68.0",
    "@tanstack/react-query": "^5.66.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "i18next": "^24.2.2",
    "i18next-icu": "^2.3.0",
    "lucide-react": "^0.475.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-i18next": "^15.4.1",
    "react-router": "^7.2.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.1.12"
