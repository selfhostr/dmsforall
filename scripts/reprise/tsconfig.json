{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2023", "DOM"],
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../apps/api/node_modules/@types", "../../node_modules/@types"],
    "paths": {
      "pg": ["../../apps/api/node_modules/pg"],
      "@node-rs/argon2": ["../../apps/api/node_modules/@node-rs/argon2"]
    }
  },
  "include": ["**/*.ts"]
}
