# =================================================================================================
# dfa-relances-chien-de-garde.service — unité systemd « oneshot » exécutant
# chien-de-garde-relances.sh. Gabarit à copier vers
# /etc/systemd/system/dfa-relances-chien-de-garde.service (à côté du .timer), voir
# docs/declenchement-relances-cron.md §5.
#
# Indépendante de dfa-relances.service à dessein (pas de `Requires=`/`After=` l'une sur l'autre,
# pas de déclenchement croisé) : le but précis de cette unité est de détecter le cas où
# dfa-relances.service ne tourne PAS DU TOUT, une dépendance entre les deux annulerait cette
# garantie.
# =================================================================================================
[Unit]
Description=DFA — détection du silence de dfa-relances.timer

[Service]
Type=oneshot
EnvironmentFile=/opt/dfa/.env.production
ExecStart=/opt/dfa/docker/relances/chien-de-garde-relances.sh
TimeoutStartSec=60
