# =================================================================================================
# dfa-relances.timer — planification de dfa-relances.service. Gabarit à copier vers
# /etc/systemd/system/dfa-relances.timer (à côté du .service), voir
# docs/declenchement-relances-cron.md §1 et §4 pour le détail de la fenêtre choisie.
#
# Activation :
#   systemctl daemon-reload
#   systemctl enable --now dfa-relances.timer
#   systemctl list-timers dfa-relances.timer   # confirme la PROCHAINE exécution calculée
# =================================================================================================
[Unit]
Description=DFA — planification quotidienne des relances de facturation (jours ouvrés)

[Timer]
# Lundi à vendredi, 07:30 — jamais 3h du matin, jamais le week-end (§4). Avant de dépendre du
# suffixe de fuseau horaire inline (supporté depuis systemd ≥ 239 — vérifier avec
# `systemd-analyze calendar 'Mon..Fri *-*-* 07:30:00 Europe/Zurich'` sur le serveur cible), la
# solution de repli robuste est de fixer le fuseau SYSTÈME du serveur lui-même à Europe/Zurich
# (`timedatectl set-timezone Europe/Zurich`) et de retirer le suffixe ci-dessous.
OnCalendar=Mon..Fri *-*-* 07:30:00 Europe/Zurich
# Rattrape une exécution manquée (serveur éteint/redémarré pendant la fenêtre) au prochain boot —
# cohérent avec l'idempotence des deux routes appelées (contrainte unique en base, §3) : un
# rattrapage tardif ne peut pas produire de double rappel.
Persistent=true
# Étale légèrement le déclenchement réel pour éviter un pic exact à 07:30:00 si ce serveur héberge
# un jour plusieurs timers similaires — sans conséquence fonctionnelle ici (usage prudent par
# défaut, pas une nécessité avec un seul timer de ce type).
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
