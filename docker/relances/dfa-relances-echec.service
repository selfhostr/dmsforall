# =================================================================================================
# dfa-relances-echec.service — notifieur minimal, déclenché par `OnFailure=` de
# dfa-relances.service (voir ce fichier). Ne duplique PAS la logique de déclencher-relances.sh —
# c'est précisément le filet qui doit survivre à un échec du script LUI-MÊME AVANT qu'il n'ait pu
# écrire son propre statut ou pinger son propre heartbeat (fichier d'identifiants introuvable,
# `curl` absent, permissions cassées après une mise à jour système…). Un seul appel `curl`, qui
# peut lui-même échouer sans conséquence : la sonde d'ABSENCE de ping (§5,
# docs/declenchement-relances-cron.md) reste le filet de dernier recours si même ceci ne part pas.
#
# Gabarit à copier vers /etc/systemd/system/dfa-relances-echec.service.
# =================================================================================================
[Unit]
Description=DFA — notification d'échec de dfa-relances.service

[Service]
Type=oneshot
EnvironmentFile=-/opt/dfa/secrets/relances-exploitation.env
ExecStart=/bin/sh -c '[ -n "$HEARTBEAT_URL_ECHEC" ] && curl -fsS --max-time 10 "$HEARTBEAT_URL_ECHEC" >/dev/null 2>&1 || logger -t dfa-relances "echec dfa-relances.service, HEARTBEAT_URL_ECHEC absent ou injoignable"'
