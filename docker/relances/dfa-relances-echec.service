# =================================================================================================
# dfa-relances-echec.service — notifieur minimal, déclenché par `OnFailure=` de
# dfa-relances.service (voir ce fichier). Ne duplique PAS la logique de declencher-relances.sh —
# c'est précisément le filet qui doit survivre à un échec du script LUI-MÊME AVANT qu'il n'ait pu
# écrire son propre statut ou signaler quoi que ce soit (fichier d'identifiants introuvable,
# `curl` absent, permissions cassées après une mise à jour système…). Exécute
# notifier-echec-systemd.sh (un seul événement GlitchTip, best-effort — voir lib-glitchtip.sh) ; la
# sonde d'ABSENCE (chien-de-garde-relances.sh, §5 de docs/declenchement-relances-cron.md) reste le
# filet de tout dernier recours si même ceci ne part pas.
#
# Gabarit à copier vers /etc/systemd/system/dfa-relances-echec.service.
# =================================================================================================
[Unit]
Description=DFA — notification d'échec de dfa-relances.service

[Service]
Type=oneshot
# `SENTRY_DSN` vient de .env.production — même secret que l'application, déjà en place, rien de
# nouveau à provisionner (voir lib-glitchtip.sh).
EnvironmentFile=/opt/dfa/.env.production
ExecStart=/opt/dfa/docker/relances/notifier-echec-systemd.sh
