# =================================================================================================
# dfa-relances.service — unité systemd « oneshot » exécutant declencher-relances.sh. À installer
# manuellement sur le serveur (`/etc/systemd/system/dfa-relances.service`), PAS dans le dépôt
# déployé tel quel — ce fichier est un GABARIT à adapter (chemins `/opt/dfa/...`), voir
# docs/declenchement-relances-cron.md §1.
#
# Après copie/modification :
#   systemctl daemon-reload
#   systemctl start dfa-relances.service     # test manuel immédiat, ne pas attendre le timer
#   journalctl -u dfa-relances.service -n 50 # première commande à taper en cas de doute
# =================================================================================================
[Unit]
Description=DFA — déclenchement des relances de facturation (tous tenants)
# Le service applicatif doit être joignable (Caddy termine le TLS localement, voir le script) ;
# ne bloque cependant PAS le boot dessus, ce timer ne tourne jamais avant un démarrage complet.
After=docker.service
# Si TOUS les tenants échouent ou qu'au moins un échoue, le script rend un code ≠ 0 (voir son
# commentaire de tête) : systemd marque alors ce service `failed`, visible par
# `systemctl --failed`. `OnFailure=` déclenche en plus une notification explicite (voir
# dfa-relances-echec.service), pas seulement un statut passif qu'il faudrait aller consulter.
# CORRECTIF (revue de ce gabarit) : `OnFailure=` est une directive de section [Unit], pas
# [Service] — postée dans [Service] elle est silencieusement IGNORÉE par systemd (`systemd-analyze
# verify` le confirme : « Unknown key 'OnFailure' in section [Service], ignoring »), et le filet de
# secours ne se déclenche alors jamais, sans qu'aucune erreur ne le signale. Piège d'autant plus
# sournois qu'il ne casse rien de visible : le service continue de fonctionner normalement tant
# qu'il n'échoue pas.
OnFailure=dfa-relances-echec.service

[Service]
Type=oneshot
# Jamais de secret en argument (visible via `ps aux`) : tout passe par EnvironmentFile, jamais par
# une ligne de commande. `SENTRY_DSN` (supervision, voir lib-glitchtip.sh) est DÉJÀ dans ce même
# fichier applicatif — aucun second fichier de secrets d'exploitation à maintenir pour ce
# déclencheur (voir docs/declenchement-relances-cron.md §5, revu : l'ancienne doctrine « deux
# fichiers séparés » de docker/postgres/sauvegarde/sauvegarde-postgres.sh ne s'applique pas ici,
# faute de second secret réel à isoler).
EnvironmentFile=/opt/dfa/.env.production
ExecStart=/opt/dfa/docker/relances/declencher-relances.sh
TimeoutStartSec=600
